# PostgreSQL — use Neon/Supabase/Railway or local
DATABASE_URL="postgresql://user:password@localhost:5432/scholr"

# NextAuth — generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay — get from dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# App URL (for emails, production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (optional — for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Scholr <noreply@scholr.app>"
